{
  "expo": {
    "name": "Drestly",
    "slug": "drestly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "drestly",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/Drestly.icon",
      "bundleIdentifier": "com.isaac.drestly",
      "appleTeamId": "U94VX8H9JU",
      "supportsTablet": false,
      "associatedDomains": ["applinks:drestly.com"]
    },
    "android": {
      "adaptiveIcon": {
        // TODO: set this icon up
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.isaac.drestly",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "drestly.com", "pathPrefix": "/auth" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f3eee4",
          "image": "./assets/icons/drestly-icon-1024.png",
          "dark": {
            "image": "./assets/icons/drestly-icon-alt-1024.png",
            "backgroundColor": "#1c2b22"
          },
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.919510031441-ubvmnhktm85fh2rgedncs49atbu3q05l"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a82ed151-de77-4d5e-b0bb-7f6e2f7cd021"
      }
    },
    "owner": "isaacs-org"
  }
}
